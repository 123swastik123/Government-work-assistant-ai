# ─── Supabase ────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only — NEVER expose to browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Anthropic / Claude ──────────────────────────────────────
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ─── App URL ─────────────────────────────────────────────────
# Local dev
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production (set in Vercel dashboard)
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# ─── Sentry ──────────────────────────────────────────────────
# Get from: https://sentry.io/ → Project → Settings → Client Keys
SENTRY_DSN=https://your-key@sentry.io/your-project-id
NEXT_PUBLIC_SENTRY_DSN=https://your-key@sentry.io/your-project-id
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=government-work-helper
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ─── Environment ─────────────────────────────────────────────
NODE_ENV=development
# Set to 'staging' or 'production' in Vercel environment settings
NEXT_PUBLIC_ENV=development

# ─── Rate Limiting ───────────────────────────────────────────
# Requests per minute per IP for AI endpoint
AI_RATE_LIMIT_RPM=20
# Requests per minute per IP for search endpoint
SEARCH_RATE_LIMIT_RPM=60
